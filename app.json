{
  "expo": {
    "name": "AI Fashion",
    "slug": "ai-fashion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aifashion",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aifashion.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы сфотографировать вещь и добавить её в гардероб.",
        "NSPhotoLibraryUsageDescription": "Доступ к фото нужен, чтобы добавить вещи в гардероб из галереи."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aifashion.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "baseUrl": "/ai-fashion"
    }
  }
}